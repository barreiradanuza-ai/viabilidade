# =====================================================================
# Copie este arquivo para .env e preencha. NUNCA versione o .env.
#
# Se for subir com Docker (o caminho mais simples), só ADMIN_EMAIL e
# ADMIN_SENHA são obrigatórios — o resto tem padrão que funciona.
# =====================================================================

# ---- Administrador (criado/atualizado a cada subida) -----------------
ADMIN_EMAIL=voce@empresa.com
ADMIN_NOME=Seu Nome
ADMIN_SENHA=troque-por-uma-senha-longa

# ---- Porta em que o site vai abrir -----------------------------------
PORTA=3000

# ---- Banco -----------------------------------------------------------
# Com docker compose, deixe DATABASE_URL em branco: o compose monta a URL
# sozinho. Preencha só se for apontar para um PostgreSQL que já existe.
POSTGRES_PASSWORD=troque-esta-senha-do-banco
# DATABASE_URL=postgresql://usuario:SENHA@host:5432/viabilidade
PGPOOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000

# ---- Quem pode consultar --------------------------------------------
# false (padrão) = só entra quem tem login. É o certo para um link público:
#   sua base de cobertura da TIM é dado comercial.
# true = qualquer pessoa com o endereço consulta, sem login.
ACESSO_PUBLICO=false

# ---- Sessão -----------------------------------------------------------
# Na sua máquina, pode deixar em branco: o sistema gera e guarda no volume.
# NA NUVEM É OBRIGATÓRIO definir — o disco some a cada deploy e, sem isso,
# todo mundo é deslogado a cada publicação. Gere com:
#   openssl rand -base64 48
SESSION_SECRET=

# ---- Upload da base TIM ----------------------------------------------
# Limite por arquivo. 512 MB dá folga para os CSVs da TIM.
UPLOAD_MAX_BYTES=536870912
# Fora do Docker, aponte para uma pasta fora do diretório público:
# UPLOAD_DIR=/var/lib/viabilidade/uploads

# ---- Integração NIO -------------------------------------------------
# BASE_LOCAL   = consulta a tabela ceps_nio, alimentada pelo job de
#                sincronização (sync_nio_ceps.py). É o modo em uso.
# API          = consome um endpoint HTTP, quando a NIO liberar um.
# INDISPONIVEL = a tela existe e avisa que não há fonte conectada.
NIO_MODO=BASE_LOCAL

# Acima disso, a base sincronizada é sinalizada como desatualizada na tela
# e no painel. O sync roda uma vez por dia, então 48h dá folga para uma
# execução falhar sem alarme falso.
NIO_MAX_IDADE_HORAS=48

# Usados apenas quando NIO_MODO=API.
NIO_API_URL=
NIO_API_TOKEN=
NIO_TIMEOUT_MS=8000

# Observação sobre o Power BI da NIO:
# o link fornecido é "Publicar na web" (relatório anônimo). Não tem API
# oficial de consulta. Os códigos de parceiro ficam no ambiente do job de
# sincronização (repositório mcc-back), não aqui — este sistema nunca abre
# o relatório, apenas lê a tabela que o job alimenta. Veja o README.
